# Konfiguracja bazy danych (plik w wolumenie Dockera)
DB_URL=jdbc:h2:file:/app/data/ztiddb;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=changeme_local_db_pass
JPA_DDL_AUTO=update

# Bezpieczeństwo JWT (minimum 64 znaki dla HMAC-SHA512)
APP_JWT_SECRET=zmien_ten_klucz_na_bardzo_dlugi_losowy_ciag_znakow_minimum_64_znaki_1234567890

# URL frontendu
APP_FRONTEND_URL=http://localhost:5173

# OAuth 2.0 GitHub (opcjonalne - zostaw not-configured jeśli nie używasz)
GITHUB_CLIENT_ID=not-configured
GITHUB_CLIENT_SECRET=not-configured

# OpenID Connect Google (opcjonalne - zostaw not-configured jeśli nie używasz)
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured